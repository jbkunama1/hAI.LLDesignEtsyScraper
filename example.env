# Etsy Shop Exporter - Umgebungsvariablen
# Diese Datei als .env kopieren und mit deinen Werten fuellen

# Etsy API Credentials (aus https://www.etsy.com/developers/your-apps)
ETSY_API_KEY=your_api_key_here
ETSY_SHARED_SECRET=your_shared_secret_here

# OAuth Access Token (mit Scopes: listings_r, shipping_r)
ETSY_ACCESS_TOKEN=your_access_token_here

# Deine Shop ID (numerisch, z.B. 12345678)
ETSY_SHOP_ID=your_shop_id_here

# Ausgabeverzeichnis (optional, Default: ./etsy_export)
ETSY_OUTPUT_DIR=./etsy_export

# Bilder herunterladen? (1 = ja, 0 = nein)
ETSY_DOWNLOAD_IMAGES=1

# Batch Size fuer API-Requests (optional, Default: 250)
ETSY_BATCH_SIZE=250